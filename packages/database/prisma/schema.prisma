generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  invited
  active
  disabled
}

enum AccessRole {
  global_admin
  city_admin
  local_admin
  staff
}

enum ScopeType {
  platform
  city
  business
}

enum CityStatus {
  active
  coming_soon
  disabled
}

enum TemplateCategory {
  commerce
  service
  hospitality
  editorial
  custom
}

enum ModuleCode {
  content
  catalog
  forms_inbox
  booking
  hospitality
  listings
  directory
  events
}

enum BusinessStatus {
  draft
  active
  paused
  disabled
}

enum BusinessPlan {
  free
  pro
  premium
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

enum PublicationStatus {
  draft
  in_review
  published
  archived
}

enum MediaAssetKind {
  image
  video
  document
  external
}

enum CollectionType {
  featured
  editorial
  neighborhood
  seasonal
  promotion
}

enum CollectionItemType {
  business
  category
  page
  external
}

enum InquiryStatus {
  new
  read
  closed
}

enum PickupOrderStatus {
  new
  accepted
  preparing
  ready
  completed
  cancelled
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String?           @map("password_hash")
  name              String?
  phone             String?
  status            UserStatus        @default(invited)
  emailVerifiedAt   DateTime?         @map("email_verified_at")
  phoneVerifiedAt   DateTime?         @map("phone_verified_at")
  lastLoginAt       DateTime?         @map("last_login_at")
  authVersion       Int               @default(1) @map("auth_version")
  accessGrants      AccessGrant[]
  createdAccesses   AccessGrant[]     @relation("AccessGrantCreatedBy")
  ownedBusinesses   Business[]        @relation("BusinessOwner")
  uploadedAssets    MediaAsset[]      @relation("MediaAssetUploader")
  publishedPages    BusinessPage[]    @relation("BusinessPagePublisher")
  publishedSections BusinessSection[] @relation("BusinessSectionPublisher")
  actorAuditLogs    AuditLog[]        @relation("AuditLogActor")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

model AccessGrant {
  id              String     @id @default(cuid())
  userId          String     @map("user_id")
  role            AccessRole
  scopeType       ScopeType  @map("scope_type")
  cityId          String?    @map("city_id")
  businessId      String?    @map("business_id")
  active          Boolean    @default(true)
  createdByUserId String?    @map("created_by_user_id")
  lastUsedAt      DateTime?  @map("last_used_at")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUser   User?      @relation("AccessGrantCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  city            City?      @relation(fields: [cityId], references: [id], onDelete: SetNull)
  business        Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([userId], map: "access_grants_user_id_idx")
  @@index([cityId], map: "access_grants_city_id_idx")
  @@index([businessId], map: "access_grants_business_id_idx")
  @@index([role, scopeType], map: "access_grants_role_scope_type_idx")
  @@map("access_grants")
}

model CityRegistry {
  id                 String    @id @default(cuid())
  name               String
  asciiName          String?   @map("ascii_name")
  slug               String
  externalId         String?   @map("external_id")
  alternateNames     String?   @map("alternate_names")
  provinceCode       String?   @map("province_code")
  provinceName       String?   @map("province_name")
  regionCode         String?   @map("region_code")
  regionName         String?   @map("region_name")
  admin1Code         String?   @map("admin1_code")
  admin1Name         String?   @map("admin1_name")
  admin2Code         String?   @map("admin2_code")
  admin2Name         String?   @map("admin2_name")
  admin3Code         String?   @map("admin3_code")
  admin4Code         String?   @map("admin4_code")
  country            String    @default("IT")
  countryName        String?   @map("country_name")
  istatCode          String?   @unique @map("istat_code")
  cadastralCode      String?   @unique @map("cadastral_code")
  featureClass       String?   @map("feature_class")
  featureCode        String?   @map("feature_code")
  population         Int?
  timezone           String?
  source             String?
  sourceVersion      String?   @map("source_version")
  sourceModifiedAt   DateTime? @map("source_modified_at") @db.Date
  lat                Float?
  lng                Float?
  activeMunicipality Boolean   @default(true) @map("active_municipality")
  searchText         String?   @map("search_text")
  cities             City[]
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([source, externalId], map: "city_registry_source_external_id_key")
  @@index([slug], map: "city_registry_slug_idx")
  @@index([name], map: "city_registry_name_idx")
  @@index([country], map: "city_registry_country_idx")
  @@index([provinceCode], map: "city_registry_province_code_idx")
  @@index([regionCode], map: "city_registry_region_code_idx")
  @@index([admin1Code], map: "city_registry_admin1_code_idx")
  @@index([admin2Code], map: "city_registry_admin2_code_idx")
  @@index([population], map: "city_registry_population_idx")
  @@map("city_registry")
}

model City {
  id                   String           @id @default(cuid())
  registryId           String?          @map("registry_id")
  name                 String
  slug                 String           @unique
  province             String?
  region               String?
  country              String           @default("IT")
  status               CityStatus       @default(coming_soon)
  active               Boolean          @default(true)
  summary              String?
  heroTitle            String?          @map("hero_title")
  heroDescription      String?          @map("hero_description")
  primaryColor         String?          @map("primary_color")
  accentColor          String?          @map("accent_color")
  toneOfVoice          String?          @map("tone_of_voice")
  sortOrder            Int              @default(0) @map("sort_order")
  seoTitle             String?          @map("seo_title")
  seoDescription       String?          @map("seo_description")
  featuredImageAssetId String?          @map("featured_image_asset_id")
  settingsJson         Json?            @map("settings_json")
  publishedAt          DateTime?        @map("published_at")
  registry             CityRegistry?    @relation(fields: [registryId], references: [id], onDelete: SetNull)
  featuredImageAsset   MediaAsset?      @relation("CityFeaturedImage", fields: [featuredImageAssetId], references: [id], onDelete: SetNull)
  businesses           Business[]
  mediaAssets          MediaAsset[]     @relation("CityMediaAssets")
  categories           CityCategory[]
  collections          CityCollection[]
  events               CityEvent[]
  accessGrants         AccessGrant[]
  auditLogs            AuditLog[]
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  @@unique([registryId], map: "cities_registry_id_key")
  @@index([status, active], map: "cities_status_active_idx")
  @@index([sortOrder], map: "cities_sort_order_idx")
  @@index([publishedAt], map: "cities_published_at_idx")
  @@map("cities")
}

model MediaAsset {
  id                        String               @id @default(cuid())
  kind                      MediaAssetKind       @default(image)
  scopeType                 ScopeType            @map("scope_type")
  cityId                    String?              @map("city_id")
  businessId                String?              @map("business_id")
  uploadedByUserId          String?              @map("uploaded_by_user_id")
  storageProvider           String               @default("external") @map("storage_provider")
  bucket                    String?
  objectKey                 String?              @map("object_key")
  publicUrl                 String?              @map("public_url")
  mimeType                  String?              @map("mime_type")
  sizeBytes                 Int?                 @map("size_bytes")
  width                     Int?
  height                    Int?
  altText                   String?              @map("alt_text")
  caption                   String?
  metadataJson              Json?                @map("metadata_json")
  city                      City?                @relation("CityMediaAssets", fields: [cityId], references: [id], onDelete: SetNull)
  business                  Business?            @relation("BusinessMediaAssets", fields: [businessId], references: [id], onDelete: SetNull)
  uploadedByUser            User?                @relation("MediaAssetUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  cityFeaturedImageUsages   City[]               @relation("CityFeaturedImage")
  businessLogoUsages        Business[]           @relation("BusinessLogoAsset")
  businessCoverUsages       Business[]           @relation("BusinessCoverAsset")
  collectionCoverUsages     CityCollection[]     @relation("CityCollectionCoverAsset")
  collectionItemImageUsages CityCollectionItem[] @relation("CityCollectionItemImageAsset")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")

  @@index([scopeType, cityId, businessId], map: "media_assets_scope_city_business_idx")
  @@index([cityId, kind], map: "media_assets_city_kind_idx")
  @@index([businessId, kind], map: "media_assets_business_kind_idx")
  @@index([uploadedByUserId], map: "media_assets_uploaded_by_user_id_idx")
  @@map("media_assets")
}

model PlatformModule {
  id            String     @id @default(cuid())
  code          ModuleCode @unique
  name          String
  description   String?
  active        Boolean    @default(true)
  publicEnabled Boolean    @default(true) @map("public_enabled")
  adminEnabled  Boolean    @default(true) @map("admin_enabled")
  sortOrder     Int        @default(0) @map("sort_order")
  settingsJson  Json?      @map("settings_json")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([active, sortOrder], map: "platform_modules_active_sort_order_idx")
  @@map("platform_modules")
}

model CityCategory {
  id                  String                       @id @default(cuid())
  cityId              String                       @map("city_id")
  parentId            String?                      @map("parent_id")
  slug                String                       @db.VarChar(160)
  name                String                       @db.VarChar(160)
  description         String?
  moduleCode          ModuleCode?                  @map("module_code")
  icon                String?
  color               String?
  active              Boolean                      @default(true)
  sortOrder           Int                          @default(0) @map("sort_order")
  seoTitle            String?                      @map("seo_title")
  seoDescription      String?                      @map("seo_description")
  settingsJson        Json?                        @map("settings_json")
  city                City                         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  parent              CityCategory?                @relation("CityCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children            CityCategory[]               @relation("CityCategoryTree")
  businessAssignments BusinessCategoryAssignment[]
  collectionItems     CityCollectionItem[]
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  @@unique([cityId, slug], map: "city_categories_city_id_slug_key")
  @@index([cityId, active, sortOrder], map: "city_categories_city_active_sort_order_idx")
  @@index([parentId], map: "city_categories_parent_id_idx")
  @@index([moduleCode, active], map: "city_categories_module_active_idx")
  @@map("city_categories")
}

model BusinessTemplate {
  id                String           @id @default(cuid())
  code              String           @unique
  name              String
  category          TemplateCategory
  primaryModule     ModuleCode       @map("primary_module")
  fieldSchemaJson   Json?            @map("field_schema_json")
  sectionSchemaJson Json?            @map("section_schema_json")
  defaultCtaLabel   String?          @map("default_cta_label")
  active            Boolean          @default(true)
  businesses        Business[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([category, active], map: "business_templates_category_active_idx")
  @@map("business_templates")
}

model Business {
  id                  String                       @id @default(cuid())
  cityId              String                       @map("city_id")
  templateId          String                       @map("template_id")
  name                String
  slug                String
  legalName           String?                      @map("legal_name")
  category            TemplateCategory?
  status              BusinessStatus               @default(draft)
  plan                BusinessPlan                 @default(free)
  subscriptionStatus  SubscriptionStatus           @default(trialing) @map("subscription_status")
  publicEmail         String?                      @map("public_email")
  publicPhone         String?                      @map("public_phone")
  website             String?
  addressLine1        String?                      @map("address_line_1")
  addressLine2        String?                      @map("address_line_2")
  postalCode          String?                      @map("postal_code")
  locality            String?                      @map("locality")
  province            String?                      @map("province")
  lat                 Float?
  lng                 Float?
  timezone            String                       @default("Europe/Rome")
  currency            String                       @default("EUR")
  locale              String                       @default("it-IT")
  ownerUserId         String?                      @map("owner_user_id")
  primaryColor        String?                      @map("primary_color")
  accentColor         String?                      @map("accent_color")
  logoAssetId         String?                      @map("logo_asset_id")
  coverAssetId        String?                      @map("cover_asset_id")
  customDomain        String?                      @unique @map("custom_domain")
  domainVerifiedAt    DateTime?                    @map("domain_verified_at")
  publicTitle         String?                      @map("public_title")
  publicSubtitle      String?                      @map("public_subtitle")
  publicDescription   String?                      @map("public_description")
  seoTitle            String?                      @map("seo_title")
  seoDescription      String?                      @map("seo_description")
  settingsJson        Json?                        @map("settings_json")
  publishedAt         DateTime?                    @map("published_at")
  bookingPolicy       String?                      @map("booking_policy")
  cancellationPolicy  String?                      @map("cancellation_policy")
  notesInternal       String?                      @map("notes_internal")
  socialLinksJson     Json?                        @map("social_links_json")
  privacyContactEmail String?                      @map("privacy_contact_email")
  city                City                         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  template            BusinessTemplate             @relation(fields: [templateId], references: [id], onDelete: Restrict)
  ownerUser           User?                        @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  logoAsset           MediaAsset?                  @relation("BusinessLogoAsset", fields: [logoAssetId], references: [id], onDelete: SetNull)
  coverAsset          MediaAsset?                  @relation("BusinessCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  mediaAssets         MediaAsset[]                 @relation("BusinessMediaAssets")
  modules             BusinessModule[]
  pages               BusinessPage[]
  categoryAssignments BusinessCategoryAssignment[]
  services            BusinessService[]
  openingDays         BusinessOpeningDay[]
  inquiries           BusinessInquiry[]
  orderingSettings    BusinessOrderingSettings?
  pickupOrders        PickupOrder[]
  collectionItems     CityCollectionItem[]
  organizedEvents     CityEvent[]                  @relation("CityEventOrganizer")
  accessGrants        AccessGrant[]
  auditLogs           AuditLog[]
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  @@unique([cityId, slug], map: "businesses_city_id_slug_key")
  @@index([cityId, status], map: "businesses_city_id_status_idx")
  @@index([templateId], map: "businesses_template_id_idx")
  @@index([ownerUserId], map: "businesses_owner_user_id_idx")
  @@index([publishedAt], map: "businesses_published_at_idx")
  @@map("businesses")
}

model BusinessService {
  id               String            @id @default(cuid())
  businessId       String            @map("business_id")
  name             String            @db.VarChar(160)
  slug             String            @db.VarChar(160)
  shortDescription String?           @map("short_description") @db.VarChar(280)
  description      String?
  priceLabel       String?           @map("price_label") @db.VarChar(80)
  priceCents       Int?              @map("price_cents")
  durationMinutes  Int?              @map("duration_minutes")
  pickupEnabled    Boolean           @default(false) @map("pickup_enabled")
  status           PublicationStatus @default(draft)
  sortOrder        Int               @default(0) @map("sort_order")
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pickupOrderItems PickupOrderItem[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([businessId, slug], map: "business_services_business_id_slug_key")
  @@index([businessId, status, sortOrder], map: "business_services_business_status_sort_order_idx")
  @@map("business_services")
}

model BusinessOpeningDay {
  id         String                    @id @default(cuid())
  businessId String                    @map("business_id")
  weekday    Int
  isClosed   Boolean                   @default(false) @map("is_closed")
  note       String?                   @db.VarChar(280)
  business   Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  intervals  BusinessOpeningInterval[]
  createdAt  DateTime                  @default(now()) @map("created_at")
  updatedAt  DateTime                  @updatedAt @map("updated_at")

  @@unique([businessId, weekday], map: "business_opening_days_business_id_weekday_key")
  @@index([businessId, weekday], map: "business_opening_days_business_weekday_idx")
  @@map("business_opening_days")
}

model BusinessOpeningInterval {
  id           String             @id @default(cuid())
  openingDayId String             @map("opening_day_id")
  opensAt      String             @map("opens_at") @db.VarChar(5)
  closesAt     String             @map("closes_at") @db.VarChar(5)
  sortOrder    Int                @default(0) @map("sort_order")
  openingDay   BusinessOpeningDay @relation(fields: [openingDayId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([openingDayId, sortOrder], map: "business_opening_intervals_day_sort_order_idx")
  @@map("business_opening_intervals")
}

model BusinessInquiry {
  id              String        @id @default(cuid())
  businessId      String        @map("business_id")
  name            String        @db.VarChar(120)
  email           String        @db.VarChar(200)
  phone           String?       @db.VarChar(60)
  message         String
  privacyAccepted Boolean       @map("privacy_accepted")
  status          InquiryStatus @default(new)
  readAt          DateTime?     @map("read_at")
  internalNote    String?       @map("internal_note")
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([businessId, status, createdAt], map: "business_inquiries_business_status_created_at_idx")
  @@map("business_inquiries")
}

model BusinessOrderingSettings {
  id                String   @id @default(cuid())
  businessId        String   @unique @map("business_id")
  enabled           Boolean  @default(false)
  pickupLeadMinutes Int      @default(30) @map("pickup_lead_minutes")
  slotMinutes       Int      @default(15) @map("slot_minutes")
  slotCapacity      Int      @default(4) @map("slot_capacity")
  minimumOrderCents Int      @default(0) @map("minimum_order_cents")
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("business_ordering_settings")
}

model PickupOrder {
  id              String            @id @default(cuid())
  businessId      String            @map("business_id")
  reference       String            @unique @db.VarChar(32)
  customerName    String            @map("customer_name") @db.VarChar(120)
  customerEmail   String            @map("customer_email") @db.VarChar(200)
  customerPhone   String?           @map("customer_phone") @db.VarChar(60)
  notes           String?
  pickupAt        DateTime          @map("pickup_at")
  status          PickupOrderStatus @default(new)
  totalCents      Int               @map("total_cents")
  privacyAccepted Boolean           @map("privacy_accepted")
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items           PickupOrderItem[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([businessId, pickupAt, status], map: "pickup_orders_business_pickup_status_idx")
  @@index([businessId, createdAt], map: "pickup_orders_business_created_at_idx")
  @@map("pickup_orders")
}

model PickupOrderItem {
  id             String           @id @default(cuid())
  orderId        String           @map("order_id")
  serviceId      String?          @map("service_id")
  nameSnapshot   String           @map("name_snapshot") @db.VarChar(160)
  unitPriceCents Int              @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int              @map("line_total_cents")
  notes          String?
  order          PickupOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service        BusinessService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([orderId], map: "pickup_order_items_order_id_idx")
  @@index([serviceId], map: "pickup_order_items_service_id_idx")
  @@map("pickup_order_items")
}

model BusinessCategoryAssignment {
  id         String       @id @default(cuid())
  businessId String       @map("business_id")
  categoryId String       @map("category_id")
  primary    Boolean      @default(false)
  sortOrder  Int          @default(0) @map("sort_order")
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   CityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([businessId, categoryId], map: "business_category_assignments_business_category_key")
  @@index([categoryId, primary], map: "business_category_assignments_category_primary_idx")
  @@index([businessId, primary], map: "business_category_assignments_business_primary_idx")
  @@map("business_category_assignments")
}

model BusinessModule {
  id           String     @id @default(cuid())
  businessId   String     @map("business_id")
  moduleCode   ModuleCode @map("module_code")
  active       Boolean    @default(true)
  sortOrder    Int        @default(0) @map("sort_order")
  settingsJson Json?      @map("settings_json")
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([businessId, moduleCode], map: "business_modules_business_id_module_code_key")
  @@index([moduleCode, active], map: "business_modules_module_code_active_idx")
  @@map("business_modules")
}

model BusinessPage {
  id                String               @id @default(cuid())
  businessId        String               @map("business_id")
  slug              String               @db.VarChar(160)
  title             String               @db.VarChar(160)
  description       String?
  pageType          String               @default("standard") @map("page_type") @db.VarChar(80)
  status            PublicationStatus    @default(draft)
  isHomepage        Boolean              @default(false) @map("is_homepage")
  active            Boolean              @default(true)
  sortOrder         Int                  @default(0) @map("sort_order")
  seoTitle          String?              @map("seo_title")
  seoDescription    String?              @map("seo_description")
  settingsJson      Json?                @map("settings_json")
  publishedAt       DateTime?            @map("published_at")
  publishedByUserId String?              @map("published_by_user_id")
  version           Int                  @default(1)
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publishedByUser   User?                @relation("BusinessPagePublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  sections          BusinessSection[]
  collectionItems   CityCollectionItem[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([businessId, slug], map: "business_pages_business_id_slug_key")
  @@index([businessId, sortOrder], map: "business_pages_business_id_sort_order_idx")
  @@index([businessId, status, active], map: "business_pages_business_status_active_idx")
  @@index([publishedByUserId], map: "business_pages_published_by_user_id_idx")
  @@map("business_pages")
}

model BusinessSection {
  id                String            @id @default(cuid())
  pageId            String            @map("page_id")
  code              String            @db.VarChar(120)
  title             String?           @db.VarChar(160)
  body              String?
  dataJson          Json?             @map("data_json")
  status            PublicationStatus @default(draft)
  active            Boolean           @default(true)
  sortOrder         Int               @default(0) @map("sort_order")
  publishedAt       DateTime?         @map("published_at")
  publishedByUserId String?           @map("published_by_user_id")
  version           Int               @default(1)
  page              BusinessPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  publishedByUser   User?             @relation("BusinessSectionPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([pageId, sortOrder], map: "business_sections_page_id_sort_order_idx")
  @@index([pageId, status, active], map: "business_sections_page_status_active_idx")
  @@index([publishedByUserId], map: "business_sections_published_by_user_id_idx")
  @@map("business_sections")
}

model CityCollection {
  id             String               @id @default(cuid())
  cityId         String               @map("city_id")
  slug           String               @db.VarChar(160)
  title          String               @db.VarChar(160)
  description    String?
  type           CollectionType       @default(featured)
  active         Boolean              @default(true)
  sortOrder      Int                  @default(0) @map("sort_order")
  coverAssetId   String?              @map("cover_asset_id")
  seoTitle       String?              @map("seo_title")
  seoDescription String?              @map("seo_description")
  startsAt       DateTime?            @map("starts_at")
  endsAt         DateTime?            @map("ends_at")
  settingsJson   Json?                @map("settings_json")
  city           City                 @relation(fields: [cityId], references: [id], onDelete: Cascade)
  coverAsset     MediaAsset?          @relation("CityCollectionCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  items          CityCollectionItem[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@unique([cityId, slug], map: "city_collections_city_id_slug_key")
  @@index([cityId, type, active, sortOrder], map: "city_collections_city_type_active_sort_order_idx")
  @@index([coverAssetId], map: "city_collections_cover_asset_id_idx")
  @@map("city_collections")
}

model CityCollectionItem {
  id           String             @id @default(cuid())
  collectionId String             @map("collection_id")
  itemType     CollectionItemType @map("item_type")
  businessId   String?            @map("business_id")
  categoryId   String?            @map("category_id")
  pageId       String?            @map("page_id")
  title        String?            @db.VarChar(160)
  subtitle     String?
  href         String?
  imageAssetId String?            @map("image_asset_id")
  active       Boolean            @default(true)
  sortOrder    Int                @default(0) @map("sort_order")
  startsAt     DateTime?          @map("starts_at")
  endsAt       DateTime?          @map("ends_at")
  metadataJson Json?              @map("metadata_json")
  collection   CityCollection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  business     Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     CityCategory?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  page         BusinessPage?      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  imageAsset   MediaAsset?        @relation("CityCollectionItemImageAsset", fields: [imageAssetId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([collectionId, active, sortOrder], map: "city_collection_items_collection_active_sort_order_idx")
  @@index([businessId], map: "city_collection_items_business_id_idx")
  @@index([categoryId], map: "city_collection_items_category_id_idx")
  @@index([pageId], map: "city_collection_items_page_id_idx")
  @@index([imageAssetId], map: "city_collection_items_image_asset_id_idx")
  @@map("city_collection_items")
}

model CityEvent {
  id                  String            @id @default(cuid())
  cityId              String            @map("city_id")
  organizerBusinessId String?           @map("organizer_business_id")
  title               String            @db.VarChar(160)
  slug                String            @db.VarChar(160)
  summary             String            @db.VarChar(280)
  description         String?
  organizerName       String            @map("organizer_name") @db.VarChar(160)
  venueName           String            @map("venue_name") @db.VarChar(160)
  addressLine1        String?           @map("address_line_1") @db.VarChar(200)
  startsAt            DateTime          @map("starts_at")
  endsAt              DateTime?         @map("ends_at")
  timezone            String            @default("Europe/Rome") @db.VarChar(80)
  status              PublicationStatus @default(draft)
  active              Boolean           @default(true)
  publishedAt         DateTime?         @map("published_at")
  city                City              @relation(fields: [cityId], references: [id], onDelete: Cascade)
  organizerBusiness   Business?         @relation("CityEventOrganizer", fields: [organizerBusinessId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([cityId, slug], map: "city_events_city_id_slug_key")
  @@index([cityId, status, active, startsAt], map: "city_events_city_status_active_starts_at_idx")
  @@index([organizerBusinessId, startsAt], map: "city_events_organizer_starts_at_idx")
  @@map("city_events")
}

model AuditLog {
  id           String    @id @default(cuid())
  actorUserId  String?   @map("actor_user_id")
  action       String
  targetType   String    @map("target_type")
  targetId     String?   @map("target_id")
  scopeType    ScopeType @map("scope_type")
  cityId       String?   @map("city_id")
  businessId   String?   @map("business_id")
  metadataJson Json?     @map("metadata_json")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  actorUser    User?     @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  city         City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([actorUserId], map: "audit_logs_actor_user_id_idx")
  @@index([scopeType, cityId, businessId], map: "audit_logs_scope_city_business_idx")
  @@index([targetType, targetId], map: "audit_logs_target_type_target_id_idx")
  @@index([action, createdAt], map: "audit_logs_action_created_at_idx")
  @@map("audit_logs")
}
