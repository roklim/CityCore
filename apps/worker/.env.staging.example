# CityCore worker staging environment template.
# Store real values in the hosting provider, not in git.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/citycore_staging?schema=public
REDIS_URL=rediss://USER:PASSWORD@HOST:6379
AUTH_SECRET=replace-with-a-long-random-secret
WORKER_NAME=citycore-worker-staging
