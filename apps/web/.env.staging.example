# CityCore web staging uses a dedicated Vercel project.
# This value is public because it is bundled into the browser.
NEXT_PUBLIC_API_BASE_URL=https://citycore-api-thesis-staging.onrender.com
NEXT_PUBLIC_SITE_URL=https://citycore-web-staging.vercel.app
# Staging must expose upstream failures instead of silently serving editorial demo data.
CITYCORE_ENABLE_EDITORIAL_FALLBACK=false
