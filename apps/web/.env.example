# Copy to apps/web/.env.local before starting the V2 web app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Canonical public origin used by metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Editorial records may replace an unavailable API only in explicit demo environments.
CITYCORE_ENABLE_EDITORIAL_FALLBACK=true
