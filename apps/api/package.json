{
  "name": "@platform/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm --prefix ../.. run db:generate && tsc -p tsconfig.json",
    "prestart": "npm --prefix ../.. run db:migrate:deploy",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:watch": "vitest test/unit",
    "test:coverage": "vitest run test/unit --coverage",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@prisma/client": "^6.15.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
