# Copy to apps/api/.env before starting the CityCore API.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citycore?schema=public
REDIS_URL=redis://localhost:6379
AUTH_SECRET=development-auth-secret-change-before-staging
# Required only for the one-time bootstrap in production.
# AUTH_BOOTSTRAP_SECRET=replace-with-a-random-production-secret
# Comma-separated browser origins allowed by CORS in production.
WEB_ORIGINS=http://localhost:3000,http://localhost:3001
# Number of trusted reverse-proxy hops (Render uses one).
TRUST_PROXY_HOPS=1
