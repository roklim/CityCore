{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@platform/config": ["packages/config/src/index.ts"],
      "@platform/database": ["packages/database/src/index.ts"],
      "@platform/shared": ["packages/shared/src/index.ts"],
      "@platform/permissions": ["packages/permissions/src/index.ts"],
      "@platform/templates": ["packages/templates/src/index.ts"],
      "@platform/ui": ["packages/ui/src/index.ts"]
    }
  }
}
