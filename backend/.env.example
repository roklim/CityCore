# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/pizzaApp?retryWrites=true&w=majority&appName=pizzaApp

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Global platform admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Default tenant
DEFAULT_BUSINESS_SLUG=mucho-gusto

# Server
PORT=3000
NODE_ENV=production

# Frontend URLs on Vercel. Use CORS_ORIGINS for multiple apps.
# Tip: per includere anche i Preview Deployments di Vercel, puoi usare wildcard:
#   CORS_ORIGINS=https://mucho-gusto.vercel.app,https://*.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app
CORS_ORIGINS=https://mucho-gusto.vercel.app,https://sushi.vercel.app

# (Opzionale) Se vuoi accettare QUALSIASI dominio `https://*.vercel.app`
# (preview deploy compresi) senza doverli listare uno per uno:
# CORS_ALLOW_VERCEL_APP=true

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Pickup slots
PICKUP_SLOT_MINUTES=15
PICKUP_MAX_ORDERS_PER_SLOT=4
PICKUP_START_TIME=18:00
PICKUP_END_TIME=22:30
PICKUP_TIME_ZONE=Europe/Rome
PICKUP_MIN_PREPARATION_MINUTES=30
PICKUP_CLOSED_WEEKDAYS=1
