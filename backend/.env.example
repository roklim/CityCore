# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/pizzaApp?retryWrites=true&w=majority&appName=pizzaApp

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Server
PORT=3000
NODE_ENV=production

# Frontend URL on Vercel
CORS_ORIGIN=https://your-frontend.vercel.app

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

