# ── Database ──────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/pizzeria

# ── Auth ──────────────────────────────────────
JWT_SECRET=cambia-questo-segreto-in-produzione
JWT_EXPIRES_IN=8h

# ── Admin credentials ─────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-questa-password

# ── Server ────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS (lascia * per dev, usa dominio in prod) ──
CORS_ORIGIN=*

# ── Rate limit ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
