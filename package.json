{
  "name": "citycore-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --workspace @platform/web run dev",
    "dev:api": "npm --workspace @platform/api run dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:validate": "node tools/run-prisma.mjs validate",
    "db:migrate:status": "node tools/run-prisma.mjs migrate status",
    "db:migrate:deploy": "node tools/run-prisma.mjs migrate deploy",
    "db:generate": "node tools/run-prisma.mjs generate",
    "db:seed": "node tools/seed-demo.mjs",
    "db:seed:global-demo": "node tools/seed-global-demo.mjs",
    "db:verify:global-demo": "node tools/verify-global-demo.mjs",
    "db:audit:legacy-demo": "node tools/audit-legacy-demo-data.mjs",
    "db:import:geonames": "node tools/import-geonames-city-registry.mjs",
    "db:test:up": "docker compose -f compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f compose.test.yml down",
    "db:test:migrate": "node tools/run-prisma-test.mjs migrate deploy",
    "db:test:reset": "node tools/run-prisma-test.mjs migrate reset --force --skip-seed",
    "seed:global-admin": "node tools/seed-global-admin.mjs",
    "help:seed:global-admin": "node tools/seed-global-admin.mjs --help",
    "clean:build": "node tools/clean-build.mjs",
    "build": "npm run clean:build && npm run build:web && npm run build:api",
    "build:web": "npm --workspace @platform/web run build",
    "build:api": "npm --workspace @platform/api run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:migration-guard && npm --workspace @platform/api run test",
    "test:migration-guard": "node --test tools/legacy-demo-migration-guard.test.mjs",
    "test:integration": "node tools/run-integration-tests.mjs",
    "test:coverage": "npm --workspace @platform/api run test:coverage",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,md}\" \"packages/**/*.{ts,tsx,json,md}\" \"tools/**/*.mjs\" \"package.json\" \"tsconfig.json\" \"tsconfig.base.json\" \"compose.yml\" \"render.yaml\" \"render.staging.yaml\" \".github/**/*.yml\" \".vscode/*.json\" \"docs/**/*.md\"",
    "check": "npm run db:generate && npm run lint && npm run format:check && npm run typecheck && npm run build",
    "verify:platform": "node tools/verify-platform.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "dotenv": "^17.2.3"
  }
}
